<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1" author="vlad">
    <createTable tableName="users">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="username" type="varchar(255)"/>
      <column name="password" type="varchar(255)"/>
      <column name="email" type="varchar(255)"/>
      <column name="roles" type="varchar(255)"/>
      <column name="created_at" type="timestamp"/>
      <column name="updated_at" type="timestamp"/>
    </createTable>

    <createTable tableName="client">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="name" type="varchar(255)"/>
      <column name="email" type="varchar(255)"/>
      <column name="phone" type="varchar(255)"/>
      <column name="user_id" type="bigint"/>
      <column name="created_at" type="timestamp"/>
      <column name="updated_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint baseTableName="client" baseColumnNames="user_id"
                             referencedTableName="users" referencedColumnNames="id"
                             constraintName="fk_client_user"/>

    <createTable tableName="stage">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="name" type="varchar(255)"/>
      <column name="created_at" type="timestamp"/>
      <column name="updated_at" type="timestamp"/>
    </createTable>

    <createTable tableName="deal">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="title" type="varchar(255)"/>
      <column name="description" type="text"/>
      <column name="client_id" type="bigint"/>
      <column name="stage_id" type="bigint"/>
      <column name="user_id" type="bigint"/>
      <column name="created_at" type="timestamp"/>
      <column name="updated_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint baseTableName="deal" baseColumnNames="client_id"
                             referencedTableName="client" referencedColumnNames="id"
                             constraintName="fk_deal_client"/>
    <addForeignKeyConstraint baseTableName="deal" baseColumnNames="stage_id"
                             referencedTableName="stage" referencedColumnNames="id"
                             constraintName="fk_deal_stage"/>
    <addForeignKeyConstraint baseTableName="deal" baseColumnNames="user_id"
                             referencedTableName="users" referencedColumnNames="id"
                             constraintName="fk_deal_user"/>

    <createTable tableName="task">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="title" type="varchar(255)"/>
      <column name="description" type="text"/>
      <column name="due_date" type="timestamp"/>
      <column name="completed" type="boolean"/>
      <column name="deal_id" type="bigint"/>
      <column name="user_id" type="bigint"/>
      <column name="created_at" type="timestamp"/>
      <column name="updated_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint baseTableName="task" baseColumnNames="deal_id"
                             referencedTableName="deal" referencedColumnNames="id"
                             constraintName="fk_task_deal"/>
    <addForeignKeyConstraint baseTableName="task" baseColumnNames="user_id"
                             referencedTableName="users" referencedColumnNames="id"
                             constraintName="fk_task_user"/>

    <createTable tableName="invoice">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="amount" type="double"/>
      <column name="status" type="varchar(255)"/>
      <column name="issue_date" type="timestamp"/>
      <column name="deal_id" type="bigint"/>
      <column name="user_id" type="bigint"/>
      <column name="created_at" type="timestamp"/>
      <column name="updated_at" type="timestamp"/>
    </createTable>
    <addForeignKeyConstraint baseTableName="invoice" baseColumnNames="deal_id"
                             referencedTableName="deal" referencedColumnNames="id"
                             constraintName="fk_invoice_deal"/>
    <addForeignKeyConstraint baseTableName="invoice" baseColumnNames="user_id"
                             referencedTableName="users" referencedColumnNames="id"
                             constraintName="fk_invoice_user"/>
  </changeSet>
</databaseChangeLog>
